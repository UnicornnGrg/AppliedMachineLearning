    "# ===== CUMULATIVE GAIN CURVE =====\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Make sure you have y_test and y_prob_test from your best model\n",
    "# y_prob_test should be the predicted probability for class 1\n",
    "\n",
    "# 1. Build a DataFrame with scores and true labels\n",
    "gain_df = pd.DataFrame({\n",
    "    'y_true': y_test.values,\n",
    "    'score': y_prob_test\n",
    "})\n",
    "\n",
    "# 2. Sort by predicted score (descending: most likely positives first)\n",
    "gain_df = gain_df.sort_values('score', ascending=False).reset_index(drop=True)\n",
    "\n",
    "# 3. Compute cumulative metrics\n",
    "gain_df['cum_positive'] = gain_df['y_true'].cumsum()\n",
    "total_positives = gain_df['y_true'].sum()\n",
    "total_samples = len(gain_df)\n",
    "\n",
    "# Proportion of samples contacted (x-axis)\n",
    "gain_df['cum_percentage_samples'] = (np.arange(1, total_samples + 1) / total_samples) * 100\n",
    "\n",
    "# Proportion of positives captured (y-axis) – this is the \"gain\"\n",
    "gain_df['cum_percentage_positives'] = (gain_df['cum_positive'] / total_positives) * 100\n",
    "\n",
    "# 4. Plot cumulative gain curve\n",
    "plt.figure(figsize=(8, 6))\n",
    "\n",
    "# Model curve\n",
    "plt.plot(\n",
    "    gain_df['cum_percentage_samples'],\n",
    "    gain_df['cum_percentage_positives'],\n",
    "    label='Model',\n",
    ")\n",
    "\n",
    "# Baseline (random model): diagonal line\n",
    "plt.plot(\n",
    "    [0, 100],\n",
    "    [0, 100],\n",
    "    linestyle='--',\n",
    "    label='Baseline (Random)',\n",
    ")\n",
    "\n",
    "plt.xlabel('Cumulative % of Population (sorted by score)')\n",
    "plt.ylabel('Cumulative % of Positives Captured')\n",
    "plt.title('Cumulative Gain Curve (Test Set)')\n",
    "plt.legend(loc='lower right')\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
