    "# --- Helper: Preprocessing (Encoding + Scaling) ---\n",
    "def preprocess_set(df_subset, col_list, set_name):\n",
    "    # Filter columns that exist in the dataframe\n",
    "    valid_cols = [c for c in col_list if c in df_subset.columns]\n",
    "\n",
